{
  "headers": [
    {
      "source": "/videor.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/omslag/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "buildCommand": "node verktyg/filmsidor.mjs",
  "outputDirectory": "public",
  "framework": null
}
